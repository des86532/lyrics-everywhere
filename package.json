{
  "name": "lyrics-everywhere",
  "version": "0.1.0",
  "description": "Chrome and Edge extension sidebar for synced lyrics and local mix transcription",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config extension-ui/vite.config.ts",
    "lint": "tsc --project extension-ui/tsconfig.json --noEmit",
    "build:extension": "vite build --config extension-ui/vite.config.ts",
    "lint:extension": "tsc --project extension-ui/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.2",
    "@sglkc/kuromoji": "1.1.0",
    "wanakana": "5.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
