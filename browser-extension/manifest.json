{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Lyrics Everywhere 耳邊字幕",
  "version": "0.1.0",
  "description": "在 YouTube、YouTube Music、Spotify Web 播放時於側欄顯示 LRCLIB 同步歌詞與空耳；無歌詞影片可在本機辨識建立字幕。",
  "homepage_url": "https://github.com/des86532/lyrics-everywhere",
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "permissions": ["sidePanel", "tabCapture", "activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://hf.co/*",
    "https://*.hf.co/*",
    "https://lrclib.net/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://open.spotify.com/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "Open Lyrics Everywhere",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "128": "icons/128x128.png"
    }
  },
  "side_panel": { "default_path": "app/index.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-page-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["spotify-content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
